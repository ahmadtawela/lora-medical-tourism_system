APP_NAME="Lora Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- MySQL (MariaDB compatible) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lora_clinic
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=public

# Comma separated list of origins allowed to call the API (the frontend app URLs)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost

# رابط تطبيق الواجهة (Frontend) المنفصل - يُستخدم في أزرار رسائل البريد/واتساب
FRONTEND_URL=http://localhost:3000

# نطاقات مسموح لها بمناداة هذا الـ API من المتصفح (CORS). * يعمل مباشرة أثناء
# التطوير المحلي بدون تعديل. للإنتاج، اجعلها قائمة مفصولة بفواصل لنطاقات فعلية فقط.
CORS_ALLOWED_ORIGINS=*

# ---- البريد الإلكتروني (Mail) ----
# 'log' يكتب الرسائل في storage/logs/laravel.log فقط (وضع تطوير آمن بدون بريد حقيقي).
# للإرسال الفعلي، بدّل MAIL_MAILER=smtp واملأ بيانات مزود حقيقي
# (مثال: Mailgun, SendGrid, Amazon SES, أو حتى Gmail SMTP للتجربة).
MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@loraclinic.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- واتساب (WhatsApp Cloud API - Meta) ----
# اتركها WHATSAPP_ENABLED=false أثناء التطوير: سيسجَّل محتوى كل رسالة في اللوق
# فقط بدل إرسالها فعليًا. للإرسال الحقيقي، فعّلها واملأ القيمتين التاليتين
# (راجع التعليقات في config/whatsapp.php لمعرفة كيفية الحصول عليهما من Meta).
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
